     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p><text:a xlink:href="https://eu.renogy.com/renogy-100-watt-12-volt-flexible-monocrystalline-solar-panel/" xlink:type="simple">https://eu.renogy.com/renogy-100-watt-12-volt-flexible-monocrystalline-solar-panel/</text:a></text:p>
